# ==========================================
# Al-Mozare3 RAG Backend Environment Config
# ==========================================

# Google Gemini API Key (Required for Embedding & LLM)
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AQ.Ab8RN6JAtYh7z0YR5vIpuzUBTo0fnlRpZ8riTbm2pIaMhUNH5w

# Embedding Provider: 'local' (0 cost, lightweight, no quota limits) or 'gemini' (cloud API)
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Model Configurations
EMBEDDING_MODEL=models/gemini-embedding-001
CHAT_MODEL=models/gemini-3.6-flash

# Storage & Data Directories
CHROMA_DB_DIR=./chroma_db
DATA_DIR=./data

# RAG & Chunking Parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_CHUNKS=6


# Server & Automation Options
# Set to true to automatically index on startup, or use POST /api/ingest
AUTO_INGEST_ON_STARTUP=false
HOST=0.0.0.0
PORT=8000
